#!/usr/bin/env python3
"""kosha: the package manager for Vayu's tools.

  kosha list [--installed] [--json]      packages: installed version, newest release
  kosha search <words>                   find packages by name or description
  kosha info <pkg>                       details, where it lives, what it needs
  kosha install <pkg>[@version] ...      install (newest release, or a pinned one) with its dependencies
  kosha update [<pkg> ...] [--force]     update to the newest release (all installed packages without names)
  kosha outdated [--json]                what has a newer release
  kosha remove <pkg> ...                 uninstall
  kosha pin <pkg> | unpin <pkg>          keep a package on its version / let it update again
  kosha link <pkg> <path> | unlink <pkg> use a development checkout in place of the release
  kosha changelog <pkg> [<from>]         what changed (since a version)
  kosha doctor                           check every installed package: commands, links, local changes
  kosha refresh                          download the newest package list
  kosha self-update                      update kosha itself
  kosha --version | --help

Packages are git repositories; a version is a release tag. Installed
tools found on disk (cloned by hand or by an older installer) are
adopted as they are.
"""
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from kosha import VERSION  # noqa: E402
from kosha import core  # noqa: E402
from kosha.core import KoshaError  # noqa: E402

TTY = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
C = {k: (f"\033[{v}m" if TTY else "") for k, v in dict(
    b="1", d="2", r="0", red="38;2;243;139;168", green="38;2;166;227;161", yellow="38;2;249;226;175",
    mauve="38;2;203;166;247", peach="38;2;250;179;135", sky="38;2;137;220;235", gray="38;2;127;132;156").items()}


def say(msg="", end="\n"):
    print(msg, end=end, flush=True)


def ok(msg):
    say(f"{C['green']}✓{C['r']} {msg}")


def warn(msg):
    say(f"{C['yellow']}!{C['r']} {msg}", )


def err(msg):
    print(f"{C['red']}✗{C['r']} {msg}", file=sys.stderr)


def step(msg):
    say(f"{C['mauve']}::{C['r']} {C['b']}{msg}{C['r']}")


def registry():
    return core.load_registry()[0]


def get(reg, name):
    if name not in reg:
        close = [n for n in reg if n.startswith(name[:2])]
        raise KoshaError(f"no package called {name}" + (f" (did you mean {', '.join(close)}?)" if close else ""))
    return reg[name]


def table(rows, header):
    widths = [max(len(str(r[i])) for r in rows + [header]) for i in range(len(header))]
    say(C["gray"] + "  ".join(h.ljust(w) for h, w in zip(header, widths)).rstrip() + C["r"])
    for r in rows:
        say("  ".join(str(c).ljust(w) for c, w in zip(r, widths)).rstrip())


# ===================================================================== commands
def cmd_list(args):
    reg = registry()
    only_installed = "--installed" in args
    pkgs = [p for p in reg.values() if p.installed() or not only_installed]
    latest = core.latest_versions(pkgs)
    state = core.load_state()
    if "--json" in args:
        out = [{"name": p.name, "kind": p.kind, "installed": p.version(), "latest": latest.get(p.name)
                if isinstance(latest.get(p.name), (str, type(None))) else None, "pinned": state.get(p.name, {}).get("pinned", False),
                "linked": p.linked(), "description": p.description} for p in pkgs]
        say(json.dumps(out, indent=2))
        return 0
    rows = []
    for p in sorted(pkgs, key=lambda p: (p.kind != "vyom" and p.kind != "app", p.kind, p.name)):
        cur, new = p.version(), latest.get(p.name)
        new_s = new if isinstance(new, str) else ("?" if isinstance(new, Exception) else "-")
        if not cur:
            status = f"{C['gray']}not installed{C['r']}"
        elif p.linked():
            status = f"{C['sky']}linked (dev){C['r']}"
        elif state.get(p.name, {}).get("pinned"):
            status = f"{C['peach']}pinned{C['r']}"
        elif isinstance(new, str) and core.vkey(new) > core.vkey(p.exact_tag() or ""):
            status = f"{C['yellow']}update → {new}{C['r']}"
        else:
            status = f"{C['green']}up to date{C['r']}"
        rows.append((p.name, cur or "", new_s, p.kind, status))
    table(rows, ("package", "installed", "latest", "kind", "status"))
    return 0


def cmd_search(args):
    reg = registry()
    words = [w.lower() for w in args]
    hits = [p for p in reg.values() if all(w in f"{p.name} {p.description} {p.kind}".lower() for w in words)]
    if not hits:
        warn(f"nothing matches {' '.join(args)}")
        return 1
    for p in sorted(hits, key=lambda p: p.name):
        mark = f" {C['green']}[installed {p.version()}]{C['r']}" if p.installed() else ""
        say(f"{C['b']}{p.name}{C['r']}{mark}  {C['gray']}{p.kind}{C['r']}\n    {p.description}")
    return 0


def cmd_info(args):
    if not args:
        raise KoshaError("kosha info <pkg>")
    reg = registry()
    p = get(reg, args[0])
    state = core.load_state().get(p.name, {})
    latest = core.latest_versions([p]).get(p.name)
    rows = [("name", p.name), ("about", p.description), ("kind", p.kind), ("repository", p.url),
            ("website", f"https://theyashsawarkar.github.io/{p.repo.split('/')[-1]}/"),
            ("installed", (p.version() or "no") + (" (pinned)" if state.get("pinned") else "") + (" (linked)" if p.linked() else "")),
            ("latest", latest if isinstance(latest, str) else "unknown"), ("location", p.path)]
    if p.requires:
        rows.append(("requires", ", ".join(p.requires)))
    if p.commands:
        miss = p.missing_commands()
        rows.append(("needs", ", ".join(f"{c}{' (missing)' if c in miss else ''}" for c in p.commands)))
    deps = core.dependents(p.name, reg)
    if deps:
        rows.append(("needed by", ", ".join(deps)))
    w = max(len(k) for k, _ in rows)
    for k, v in rows:
        say(f"{C['gray']}{k.ljust(w)}{C['r']}  {v}")
    return 0


def offer_system(pkgs):
    """Missing commands: offer to install their Arch packages through anumati."""
    missing = {p.name: p.missing_commands() for p in pkgs if p.missing_commands()}
    if not missing:
        return
    arch = sorted({a for p in pkgs if p.name in missing for a in p.arch})
    for n, cmds in missing.items():
        warn(f"{n} needs {', '.join(cmds)}, which isn't installed")
    if not arch or not shutil.which("pacman"):
        return
    line = f"sudo pacman -S --needed {' '.join(arch)}"
    asker = shutil.which("anumati")
    if asker and sys.stdin.isatty():
        say(f"   install them? {C['gray']}({' '.join(arch)}, through anumati){C['r']} [Y/n] ", end="")
        if input().strip().lower() in ("", "y", "yes"):
            req = {"requester": "kosha", "reason": f"Packages the tools you're installing need: {', '.join(missing)}",
                   "commands": [{"cmd": f"pacman -S --needed --noconfirm {' '.join(arch)}",
                                 "why": f"Install {', '.join(arch)} (needed by {', '.join(missing)})"}]}
            r = subprocess.run([asker], input=json.dumps(req), capture_output=True, text=True)
            ok("installed") if r.returncode == 0 else warn(f"not installed ({json.loads(r.stdout or '{}').get('status', 'failed')})")
            return
    say(f"   to install them: {C['b']}{line}{C['r']}")


def cmd_install(args):
    if not args:
        raise KoshaError("kosha install <pkg>[@version] ...")
    reg = registry()
    wanted, versions = [], {}
    for a in args:
        name, _, ver = a.partition("@")
        wanted.append(name)
        if ver:
            versions[name] = ver
    order = core.resolve(wanted, reg)
    state = core.load_state()
    done = []
    for name in order:
        p = reg[name]
        if p.installed() and name not in versions and name not in wanted:
            continue   # a dependency that's already there
        step(f"{name}{' @' + versions[name] if name in versions else ''}")
        v, adopted, link = core.install(p, versions.get(name), state)
        msg = f"{name} {v}" + (" (already installed: now managed by kosha)" if adopted and name not in versions else "")
        ok(msg + (f", linked {link.replace(core.HOME, '~')}" if link else ""))
        done.append(p)
    offer_system(done)
    return 0


def cmd_outdated(args, quiet=False):
    reg = registry()
    state = core.load_state()
    pkgs = [p for p in reg.values() if p.installed() and not p.linked()]
    latest = core.latest_versions(pkgs)
    out = []
    for p in pkgs:
        new = latest.get(p.name)
        if isinstance(new, str) and core.vkey(new) > core.vkey(p.exact_tag() or p.version().split("-")[0]):
            out.append({"name": p.name, "installed": p.version(), "latest": new, "pinned": state.get(p.name, {}).get("pinned", False)})
    if "--json" in args:
        say(json.dumps(out))
    elif not quiet:
        if out:
            table([(o["name"], o["installed"], o["latest"], "pinned" if o["pinned"] else "") for o in out],
                  ("package", "installed", "latest", ""))
        else:
            ok("everything is up to date")
    return out


def cmd_update(args):
    reg = registry()
    force = "--force" in args
    names = [a for a in args if not a.startswith("-")]
    state = core.load_state()
    pkgs = [get(reg, n) for n in names] if names else [p for p in reg.values() if p.installed()]
    pkgs = [p for p in pkgs if not p.linked() or (warn(f"{p.name}: linked development checkout, skipped") and False)]
    latest = core.latest_versions(pkgs)
    todo = []
    for p in pkgs:
        new = latest.get(p.name)
        if isinstance(new, Exception):
            warn(f"{p.name}: couldn't check ({new})")
            continue
        if not p.installed():
            warn(f"{p.name} isn't installed (kosha install {p.name})")
            continue
        if not new or core.vkey(new) <= core.vkey(p.exact_tag() or (p.version() or "").split("-")[0]):
            continue
        if state.get(p.name, {}).get("pinned") and p.name not in names:
            say(f"{C['gray']}  {p.name} {p.version()} is pinned ({new} available){C['r']}")
            continue
        todo.append((p, new))
    if not todo:
        ok("everything is up to date")
        return 0
    rc = 0
    for p, new in todo:
        step(f"{p.name} {p.version()} → {new}")
        try:
            if force and p.dirty():
                core.git(["stash", "-q"], cwd=p.path)
                warn(f"local changes stashed in {p.path} (git stash pop to get them back)")
            old = core.update(p, new, state)
            log = core.changelog_between(p, old, new)
            ok(f"{p.name} {new}")
            if log:
                for line in log.splitlines()[:14]:
                    say(f"    {C['gray']}{line}{C['r']}")
        except KoshaError as e:
            err(f"{p.name}: {e}")
            rc = 1
    return rc


def cmd_remove(args):
    if not args:
        raise KoshaError("kosha remove <pkg> ...")
    reg = registry()
    state = core.load_state()
    for n in args:
        p = get(reg, n)
        if not p.installed():
            warn(f"{n} isn't installed")
            continue
        deps = [d for d in core.dependents(n, reg) if d not in args]
        if deps:
            raise KoshaError(f"{n} is needed by {', '.join(deps)} (remove those too, or keep it)")
        if p.dirty() and "--force" not in args:
            raise KoshaError(f"{p.path} has local changes: --force to remove anyway")
        core.remove(p, state)
        ok(f"removed {n}")
    return 0


def cmd_pin(args, on=True):
    if not args:
        raise KoshaError(f"kosha {'pin' if on else 'unpin'} <pkg>")
    reg = registry()
    state = core.load_state()
    for n in args:
        p = get(reg, n)
        if not p.installed():
            raise KoshaError(f"{n} isn't installed")
        state.setdefault(n, {"path": p.path})["pinned"] = on
        state[n]["version"] = p.version()
        ok(f"{n} {'pinned at ' + p.version() if on else 'will update again'}")
    core.save_state(state)
    return 0


def cmd_link(args):
    if len(args) != 2:
        raise KoshaError("kosha link <pkg> <path to your checkout>")
    reg = registry()
    p = get(reg, args[0])
    src = os.path.abspath(os.path.expanduser(args[1]))
    if not os.path.isdir(os.path.join(src, ".git")):
        raise KoshaError(f"{src} isn't a git checkout")
    state = core.load_state()
    if p.installed() and not p.linked():
        backup = p.path + ".kosha-release"
        if os.path.exists(backup):
            raise KoshaError(f"{backup} is in the way")
        os.rename(p.path, backup)
        state.setdefault(p.name, {})["release_backup"] = backup
    elif p.linked():
        os.remove(p.path)
    os.makedirs(os.path.dirname(p.path), exist_ok=True)
    os.symlink(src, p.path)
    core.link_bin(p)
    core.reload_hook(p)
    state.setdefault(p.name, {}).update(path=p.path, linked=src)
    core.save_state(state)
    core.log(f"link {p.name} {src}")
    ok(f"{p.name} now runs from {src.replace(core.HOME, '~')} (kosha unlink {p.name} goes back to the release)")
    return 0


def cmd_unlink(args):
    if not args:
        raise KoshaError("kosha unlink <pkg>")
    reg = registry()
    p = get(reg, args[0])
    if not p.linked():
        raise KoshaError(f"{p.name} isn't linked")
    os.remove(p.path)
    state = core.load_state()
    backup = state.get(p.name, {}).pop("release_backup", None)
    state.get(p.name, {}).pop("linked", None)
    core.save_state(state)
    if backup and os.path.isdir(backup):
        os.rename(backup, p.path)
        core.link_bin(p)
        core.reload_hook(p)
        ok(f"{p.name} back on {p.version()}")
    else:
        core.install(p, None, state)
        ok(f"{p.name} reinstalled at {p.version()}")
    return 0


def cmd_changelog(args):
    if not args:
        raise KoshaError("kosha changelog <pkg> [<since version>]")
    reg = registry()
    p = get(reg, args[0])
    if not p.installed():
        raise KoshaError(f"{p.name} isn't installed: see https://theyashsawarkar.github.io/{p.repo.split('/')[-1]}/changelog.html")
    text = open(os.path.join(p.path, "CHANGELOG.md")).read()
    if len(args) > 1:
        text = core.changelog_between(p, args[1], "v999.0.0") or f"nothing since {args[1]}"
    pager = os.environ.get("PAGER", "less -R") if TTY else None
    if pager and len(text.splitlines()) > 40:
        subprocess.run(pager, shell=True, input=text, text=True)
    else:
        say(text)
    return 0


def cmd_doctor(args):
    reg = registry()
    problems = 0
    if not shutil.which("git"):
        err("git isn't installed")
        return 1
    if core.BIN not in os.environ.get("PATH", "").split(":"):
        warn(f"{core.BIN} isn't on your PATH: installed commands won't be found")
        problems += 1
    for p in sorted(reg.values(), key=lambda p: p.name):
        if not p.installed():
            continue
        issues = []
        missing_deps = [d for d in p.requires if d not in reg or not reg[d].installed()]
        if missing_deps:
            issues.append(f"requires {', '.join(missing_deps)} (kosha install {' '.join(missing_deps)})")
        miss = p.missing_commands()
        if miss:
            issues.append(f"needs {', '.join(miss)} on PATH")
        t = p.bin_target
        if t and os.path.exists(t[1]) and not (os.path.islink(t[0]) and os.path.realpath(t[0]) == os.path.realpath(t[1])):
            issues.append(f"{t[0].replace(core.HOME, '~')} doesn't point to it (kosha install {p.name} fixes it)")
        if p.dirty():
            issues.append("has local changes (updates are refused until they're committed or stashed)")
        if not p.linked() and not p.exact_tag():
            issues.append(f"not on a release ({p.version()}): kosha update {p.name}")
        if issues:
            problems += 1
            warn(f"{C['b']}{p.name}{C['r']}")
            for i in issues:
                say(f"    {i}")
        else:
            ok(f"{p.name} {p.version()}{' (linked)' if p.linked() else ''}")
    say()
    (ok("no problems") if not problems else warn(f"{problems} package{'s' if problems > 1 else ''} need attention"))
    return 1 if problems else 0


def cmd_refresh(args):
    core.refresh_registry()
    ok(f"package list updated: {len(registry())} packages")
    return 0


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        say(__doc__.strip())
        return 0
    if args[0] in ("-V", "--version"):
        say(f"kosha {VERSION}")
        return 0
    cmd, rest = args[0], args[1:]
    table_ = {"list": cmd_list, "ls": cmd_list, "search": cmd_search, "info": cmd_info, "show": cmd_info,
              "install": cmd_install, "add": cmd_install, "update": cmd_update, "upgrade": cmd_update,
              "remove": cmd_remove, "uninstall": cmd_remove, "rm": cmd_remove, "pin": lambda a: cmd_pin(a, True),
              "unpin": lambda a: cmd_pin(a, False), "link": cmd_link, "unlink": cmd_unlink, "changelog": cmd_changelog,
              "doctor": cmd_doctor, "refresh": cmd_refresh,
              "outdated": lambda a: 0 if not cmd_outdated(a) or "--json" in a else 0,
              "self-update": lambda a: cmd_update(["kosha"] + a)}
    if cmd not in table_:
        err(f"unknown command {cmd} (kosha --help)")
        return 2
    try:
        return table_[cmd](rest) or 0
    except KoshaError as e:
        err(str(e))
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
