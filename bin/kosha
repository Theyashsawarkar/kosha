#!/usr/bin/env python3
"""kosha: the package manager for Vayu's tools. `kosha help` lists the commands."""
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `kosha list | head` ends quietly
from kosha.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
